# Copiá este archivo como ".env" y completá los valores.
# El .env real NO se sube a git (está en .gitignore).

PORT=3000

# Cadena de conexión de MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<base>?appName=Cluster0
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/botema_db?appName=Cluster0

# Cualquier texto largo y secreto sirve. Poné el suyo propio.
JWT_SECRET=cambia_esto_por_un_secreto_largo
